{
  "name": "websi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply websi --local",
    "db:migrate:remote": "wrangler d1 migrations apply websi --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check"
  },
  "dependencies": {
    "node-html-parser": "^7.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "^27.0.0",
    "playwright": "1.62",
    "typescript": "^5.7.2",
    "vite": "8.1.5",
    "vitest": "^3.0.5",
    "wrangler": "4.114.0"
  }
}
