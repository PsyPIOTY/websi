{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "websi",
	"main": "worker/index.ts",
	"compatibility_date": "2026-07-29",
	// global_fetch_strictly_public: WEBSI holt die Seiten wie ein Besucher aus dem Internet ab.
	// Ohne das blockt Cloudflare den Abruf eines Workers im selben Konto (Fehler 1042),
	// z. B. konzeptstudio.<name>.workers.dev und seine Vorschau-Links.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "websi",
			"database_id": "e89e2c8f-8bae-4c87-84ee-bbc7484a6407",
			"migrations_dir": "migrations"
		}
	],
	"vars": {
		"AGENT_MODE": "auto"
	},
	// Monatsprüfung: täglich 05:00 UTC Aufrufe zählen, ab dem 4. einmal prüfen.
	"triggers": {
		"crons": ["0 5 * * *"]
	}
}
